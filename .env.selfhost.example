# These are server settings, never APK or browser variables.
SELFHOST_DATABASE=postgres-local
PGHOST=/absolute/path/to/postgres/socket-directory
PGPORT=5432
PGDATABASE=espressoulster_local
# PGUSER=your_local_postgresql_role
SELFHOST_HOST=127.0.0.1
SELFHOST_PORT=5173
SELFHOST_DATA_DIR=.selfhost/data
# Optional: behind a local nginx proxy which overwrites X-Real-IP.
# SELFHOST_TRUST_PROXY=loopback
SELFHOST_MAX_CONCURRENT_REQUESTS=64
CUSTOMER_AUTH_MODE=pin
PUBLIC_TEST_MODE=false
PAYMENT_PROVIDER=disabled
PAYMENT_MODE=disabled
PAYMENT_LIVE_ENABLED=false
PAYMENT_APP_ORIGIN=http://127.0.0.1:5173

# For public use, supply your own domain and CA-issued TLS certificate.
# PAYMENT_APP_ORIGIN=https://your-owned-domain.example
# SELFHOST_HOST=0.0.0.0
# SELFHOST_PORT=443
SELFHOST_TLS_CERT=
SELFHOST_TLS_KEY=

# Put credentials in an ignored, mode-600 server env file.
# Existing .env is loaded first; .env.selfhost overrides its settings.
# PIN_AUTH_SECRET=
PIN_AUTH_OTP_ENABLED=true
CUSTOMER_OTP_ONLY=true
STAFF_OTP_ONLY=true
# otp: approved staff can verify their OTP on any device; no hardware gate.
# attestation: legacy Android hardware verification policy.
STAFF_DEVICE_POLICY=otp
# Comma-separated approved staff with full live order, chat, alert and duty access.
# These numbers must also be listed in STAFF_ONLY_PHONES or STAFF_PANEL_PHONES.
STAFF_ORDER_OPERATOR_PHONES=
OTP_DELIVERY_CHANNEL=whatsapp

# Native FCM for PostgreSQL staging. Keep the service credential outside the repo.
ANDROID_PUSH_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Cashfree sandbox. Set provider=cashfree, mode=test and PUBLIC_TEST_MODE=true.
CASHFREE_CHECKOUT_API=orders
CASHFREE_TEST_CLIENT_ID=
CASHFREE_TEST_CLIENT_SECRET=
# Isolated HTTPS staging can enable Sandbox while keeping PUBLIC_TEST_MODE=false.
# CASHFREE_STAGING_SANDBOX_ENABLED=true
# Public HTTPS callback, independent of the local browser return origin:
CASHFREE_NOTIFY_URL=
