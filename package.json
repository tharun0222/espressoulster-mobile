{
  "name": "espressoulster-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "npm run dev:selfhost",
    "build": "node scripts/build-app.mjs",
    "build:sites": "CAFE_BUILD_TARGET=sites node scripts/build-app.mjs",
    "start": "npm run start:selfhost",
    "dev:selfhost": "node --env-file-if-exists=.env --env-file-if-exists=.env.selfhost scripts/selfhost-server.mjs --dev",
    "build:selfhost": "NEXT_TELEMETRY_DISABLED=1 APP_RUNTIME=selfhost next build --webpack",
    "start:selfhost": "node --env-file-if-exists=.env --env-file-if-exists=.env.selfhost scripts/selfhost-server.mjs",
    "db:selfhost": "node --env-file-if-exists=.env --env-file-if-exists=.env.selfhost scripts/selfhost-db.mjs",
    "test:selfhost": "node --test tests/selfhost-backend.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:local": "npm run db:selfhost",
    "predev": "npm run db:selfhost",
    "test:pricing": "node --experimental-transform-types --test tests/pricing.test.mjs",
    "test:backend": "node --test tests/selfhost-http.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm run typecheck && npm run test:pricing && npm run test:subscriptions && npm run test:payments && npm run test:customer && npm run test:notifications && npm run build && npm run test:backend",
    "test:payments": "node --experimental-transform-types --test tests/payment-security.test.mjs tests/stripe-security.test.mjs tests/stripe-checkout.test.mjs tests/prepaid-checkout.test.mjs tests/payment-request.test.mjs tests/cashfree-checkout.test.mjs tests/cashfree-orders.test.mjs tests/cashfree-json.test.mjs tests/native-cashfree-checkout.test.mjs tests/table-booking-payments.test.mjs",
    "test:subscriptions": "node --experimental-transform-types --test tests/subscriptions.test.mjs",
    "test:pin": "node --experimental-transform-types --test tests/pin-auth.test.mjs tests/customer-identity.test.mjs tests/sign-out.test.mjs",
    "test:customer": "node --experimental-transform-types --test tests/customer-request.test.mjs tests/sign-out.test.mjs tests/customer-identity.test.mjs",
    "test:notifications": "node --experimental-transform-types --test tests/order-notifications.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@hookform/resolvers": "^5.7.1",
    "@peculiar/asn1-android": "3.0.0",
    "@peculiar/asn1-schema": "3.0.0",
    "@peculiar/asn1-x509": "3.0.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "google-auth-library": "11.3.4",
    "input-otp": "^1.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^5.24.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
