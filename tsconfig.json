{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-selfhost/types/**/*.ts",
    ".next-selfhost/dev/types/**/*.ts",
    ".next-phone/types/**/*.ts",
    ".next-phone/dev/types/**/*.ts",
    ".next-cashfree/types/**/*.ts",
    ".next-cashfree/dev/types/**/*.ts",
    ".selfhost/qa-full-app/next/types/**/*.ts",
    ".selfhost/qa-full-app/next/dev/types/**/*.ts",
    ".selfhost/qa-full-app/next-v1.0.16/types/**/*.ts",
    ".selfhost/qa-full-app/next-v1.0.16/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples"
  ]
}
