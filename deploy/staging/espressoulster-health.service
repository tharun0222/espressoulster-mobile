[Unit]
Description=Espressoulster database readiness check and bounded recovery

[Service]
Type=oneshot
WorkingDirectory=/home/interns/apps/espressoulster-staging/current
EnvironmentFile=/home/interns/apps/espressoulster-staging/shared/runtime.env
ExecStart=/home/interns/apps/espressoulster-staging/runtime/node-v24.22.2-linux-x64/bin/node scripts/staging-health.mjs
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=true
