[Unit]
Description=Espressoulster daily consistent database and images backup

[Service]
Type=oneshot
WorkingDirectory=/home/interns/apps/espressoulster-staging/current
EnvironmentFile=/home/interns/apps/espressoulster-staging/shared/runtime.env
Environment=SELFHOST_BACKUP_DIR=/home/interns/apps/espressoulster-staging/backups
ExecStart=/home/interns/apps/espressoulster-staging/runtime/node-v24.22.2-linux-x64/bin/node scripts/staging-backup.mjs
UMask=0077
NoNewPrivileges=true
