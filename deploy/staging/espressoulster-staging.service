[Unit]
Description=Espressoulster isolated staging app
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/interns/apps/espressoulster-staging/current
EnvironmentFile=/home/interns/apps/espressoulster-staging/shared/runtime.env
Environment=PATH=/home/interns/apps/espressoulster-staging/runtime/node-v24.22.2-linux-x64/bin:/usr/bin:/bin
ExecStart=/home/interns/apps/espressoulster-staging/runtime/node-v24.22.2-linux-x64/bin/node scripts/selfhost-server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
MemoryMax=2G
CPUQuota=200%
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=default.target
