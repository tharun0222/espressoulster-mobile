[Unit]
Description=Espressoulster staging PostgreSQL database

[Service]
Type=forking
PIDFile=/home/interns/apps/espressoulster-staging/postgres/data/postmaster.pid
ExecStart=/home/interns/apps/espressoulster-staging/runtime/postgresql-17.12/bin/pg_ctl -D /home/interns/apps/espressoulster-staging/postgres/data -l /home/interns/apps/espressoulster-staging/postgres/server.log -w start
ExecStop=/home/interns/apps/espressoulster-staging/runtime/postgresql-17.12/bin/pg_ctl -D /home/interns/apps/espressoulster-staging/postgres/data -m fast -w stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=45
MemoryMax=768M
UMask=0077
NoNewPrivileges=true
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=default.target
