# Use Sites environment settings for production. Verified admin emails only.
ADMIN_EMAILS=owner@example.com

# PhonePe Standard Checkout v2. Disabled until complete sandbox configuration.
PAYMENT_PROVIDER=phonepe
PAYMENT_MODE=test
PAYMENT_LIVE_ENABLED=false
PAYMENT_APP_ORIGIN=http://127.0.0.1:5173
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=
PHONEPE_CLIENT_SECRET=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Razorpay sandbox only. Live keys are rejected. Keep the secret server-side.
PUBLIC_TEST_MODE=true
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=

# Stripe sandbox: PAYMENT_PROVIDER=stripe, PAYMENT_MODE=test.
# Live Stripe keys and live webhook events are rejected.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Sandbox minimum in paise. This US sandbox requires at least 50 USD cents after conversion.
STRIPE_TEST_MIN_AMOUNT=5000

# Mobile + PIN sign-in. Activation requires separate publication approval.
# Generate a unique high-entropy server-only secret; never place it in the client.
CUSTOMER_AUTH_MODE=pin
PIN_AUTH_SECRET=
