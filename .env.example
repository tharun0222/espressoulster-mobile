# Server-only environment settings. For self-hosting, see .env.selfhost.example.
ADMIN_EMAILS=owner@example.com
# Comma-separated mobile numbers that can see the Admin panel shortcut after PIN sign-in.
STAFF_PANEL_PHONES=
# Comma-separated staff-only numbers blocked from customer PIN access.
STAFF_ONLY_PHONES=
# Comma-separated approved staff numbers with live order, chat and alert access.
STAFF_ORDER_OPERATOR_PHONES=
# Optional. Approved staff who can also switch the café On or Off duty.
STAFF_DUTY_PHONES=
# Loopback development only. Staff sign in with phone and PIN in the browser.
STAFF_LOCAL_PREVIEW=false
# Temporary staff PIN for loopback development when MSG91 is unconfigured.
STAFF_LOCAL_PREVIEW_PIN=
# Use Android staff sign-in. Require MSG91 OTP when PIN auth OTP is enabled.
STAFF_OTP_ONLY=true
# Optional policy; OTP-only staff access remains protected by the approved list.
STAFF_DEVICE_POLICY=otp

# Free HeiGIT Standard API key for live café directions. Server-side only.
OPENROUTESERVICE_API_KEY=

# Online checkout is disabled by default. To test PhonePe, select phonepe and add sandbox credentials.
PAYMENT_PROVIDER=disabled
PAYMENT_MODE=disabled
PAYMENT_LIVE_ENABLED=false
PAYMENT_APP_ORIGIN=http://127.0.0.1:5173
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=
PHONEPE_CLIENT_SECRET=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Set to true only on the separate sandbox server. Keep real customer data out of that server.
PUBLIC_TEST_MODE=false
# Razorpay sandbox only. Live keys are rejected. Keep the secret server-side.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=

# Stripe sandbox: PAYMENT_PROVIDER=stripe, PAYMENT_MODE=test.
# Live Stripe keys and live webhook events are rejected.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Sandbox minimum in paise. This US sandbox requires at least 50 USD cents after conversion.
STRIPE_TEST_MIN_AMOUNT=5000

# Mobile + PIN sign-in. Activation requires separate publication approval.
# Generate a unique high-entropy server-only secret; never place it in the client.
CUSTOMER_AUTH_MODE=pin
PIN_AUTH_SECRET=
# Enable only after configuring the SMS provider.
PIN_AUTH_OTP_ENABLED=true
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Set whatsapp to use the MSG91 WhatsApp template API instead of SMS.
# Authkey remains server-only. Copy these fields from the approved template's API code.
OTP_DELIVERY_CHANNEL=whatsapp
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_TEMPLATE=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANGUAGE=en
MSG91_WHATSAPP_TEMPLATE_APPROVED=false
CUSTOMER_OTP_ONLY=true
